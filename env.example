# Copier ce fichier vers .env.local et renseigner vos valeurs

# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Obligatoire pour créer des utilisateurs depuis /administration (clé secrète, jamais NEXT_PUBLIC_)
# Dashboard Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : cron e-mails d'alertes (Vercel Cron + Resend)
CRON_SECRET=
RESEND_API_KEY=
ALERTES_EMAIL_FROM=INFINITY ITAM <noreply@votre-domaine.com>
ALERTES_EMAIL_TO=it@votre-domaine.com
