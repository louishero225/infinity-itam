# Copier ce fichier vers .env.local et renseigner vos valeurs

# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Obligatoire pour créer des utilisateurs depuis /administration (clé secrète, jamais NEXT_PUBLIC_)
# Dashboard Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : URL publique de l'app (SSO Microsoft / Azure)
# NEXT_PUBLIC_SITE_URL=https://votre-domaine.vercel.app

# Optionnel : appliquer les migrations SQL en CLI (Connection string pooler, mode Transaction)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Microsoft / Azure AD (activer aussi dans Supabase → Authentication → Providers → Azure)
# Créer une app dans Entra ID (Azure AD) avec redirect URI :
#   https://VOTRE_PROJECT_ID.supabase.co/auth/v1/callback
# Puis renseigner Client ID + Secret dans le provider Azure Supabase.

# Optionnel : cron e-mails d'alertes (Vercel Cron + Resend)
CRON_SECRET=
RESEND_API_KEY=
ALERTES_EMAIL_FROM=INFINITY ITAM <noreply@votre-domaine.com>
ALERTES_EMAIL_TO=it@votre-domaine.com
